{
  "openapi": "3.1.0",
  "info": {
    "title": "MinhaAI implemented bootstrap API",
    "version": "0.1.0",
    "description": "Phase 05 runtime surface only. Health is liveness, not dependency readiness."
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_retrieve",
        "description": "Public process liveness only. Does not assert database or external service readiness.",
        "tags": [
          "api"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": ""
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "field"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/StatusEnum"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "maximum": 599,
            "minimum": 400
          },
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "field_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "code",
          "correlation_id",
          "detail",
          "status",
          "title",
          "type"
        ],
        "additionalProperties": false
      },
      "StatusEnum": {
        "enum": [
          "ok"
        ],
        "type": "string",
        "description": "* `ok` - ok"
      }
    }
  }
}
