# Copying this file is insufficient: make setup generates local values safely.
# Local development only. Never use these placeholders as credentials.
MINHAAI_ENV=local
DJANGO_SECRET_KEY=replace-with-generated-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=minhaai
POSTGRES_USER=minhaai
POSTGRES_PASSWORD=replace-with-generated-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional external identity integrations: leave absent until independently configured.
# GOOGLE_CLIENT_ID=replace-with-approved-client-id
# GOOGLE_CLIENT_SECRET=replace-with-private-server-secret
# GOOGLE_REDIRECT_URI=replace-with-exact-approved-web-callback
# EMAIL_HOST=replace-with-approved-smtp-host
# EMAIL_HOST_USER=replace-with-smtp-user
# EMAIL_HOST_PASSWORD=replace-with-private-smtp-secret
# DEFAULT_FROM_EMAIL=replace-with-approved-sender
# Private files remain disabled until storage is reviewed and ClamAV is running
# with a current official signature database. No public/static media root exists.
# PRIVATE_FILES_ROOT=/absolute/private/path/outside-web-public
# PRIVATE_FILES_STORAGE_APPROVED=1
# PRIVATE_FILES_SCANNER_HOST=127.0.0.1
# PRIVATE_FILES_SCANNER_PORT=3310
